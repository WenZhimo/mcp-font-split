{
  "name": "mcp-font-split",
  "version": "0.1.0",
  "description": "MCP server wrapping cn-font-split for agent-callable font subsetting",
  "type": "module",
  "license": "Apache-2.0",
  "author": "WenZhimo",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/",
    "scripts/",
    "batch-run.js",
    "API.md",
    "API.zh-CN.md",
    "BEHAVIOR.zh-CN.md",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/WenZhimo/mcp-font-split.git"
  },
  "homepage": "https://github.com/WenZhimo/mcp-font-split",
  "bin": {
    "mcp-font-split": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "batch:run": "node batch-run.js",
    "install:wasm": "node scripts/install-cn-font-split-wasm.js",
    "check": "npm run check:syntax && npm run check:smoke",
    "check:compact": "node scripts/run-check-compact.js",
    "check:syntax": "node --check batch-run.js && node --check scripts/install-cn-font-split-wasm.js && node --check scripts/run-check-compact.js && node --check scripts/run-smoke-suite.js && node --check src/font-split.js && node --check src/server.js && node --check src/smoke-test.js && node --check src/mcp-response.js && node --check src/smoke/fixtures.js",
    "check:smoke": "node scripts/run-smoke-suite.js",
    "smoke": "node src/smoke-test.js",
    "smoke:agent-guidance": "node src/smoke-test.js agent-guidance",
    "smoke:batch-dry-run": "node src/smoke-test.js batch-dry-run",
    "smoke:batch-error-mode": "node src/smoke-test.js batch-error-mode",
    "smoke:batch-defaults": "node src/smoke-test.js batch-defaults",
    "smoke:font-inputs": "node src/smoke-test.js font-inputs",
    "smoke:workspace-root-path": "node src/smoke-test.js workspace-root-path",
    "smoke:organize": "node src/smoke-test.js organize-dry-run",
    "smoke:organize-copy": "node src/smoke-test.js organize-copy",
    "smoke:organize-valid": "node src/smoke-test.js organize-valid-font",
    "smoke:organize-structure": "node src/smoke-test.js organize-structure-only",
    "smoke:organize-output-inside": "node src/smoke-test.js organize-output-inside-input",
    "smoke:scan-limits": "node src/smoke-test.js scan-limits",
    "smoke:check-compact": "node src/smoke-test.js check-compact",
    "smoke:batch-run": "node src/smoke-test.js batch-run-cli",
    "smoke:batch-identity": "node src/smoke-test.js batch-identity-dedupe",
    "smoke:workflow-presets": "node src/smoke-test.js workflow-presets",
    "smoke:real-corpus-readonly": "node src/smoke-test.js real-corpus-readonly",
    "smoke:real-corpus-suite": "node src/smoke-test.js real-corpus-suite",
    "smoke:real-corpus-targets": "node src/smoke-test.js real-corpus-targets",
    "smoke:real-corpus-integration": "node src/smoke-test.js real-corpus-integration",
    "smoke:incremental": "node src/smoke-test.js batch-incremental",
    "smoke:batch-compact": "node src/smoke-test.js batch-compact",
    "smoke:inspect-compact": "node src/smoke-test.js inspect-compact",
    "smoke:inspect-structure": "node src/smoke-test.js inspect-structure",
    "smoke:inspect-organized-staging": "node src/smoke-test.js inspect-organized-staging",
    "smoke:mcp-error": "node src/smoke-test.js mcp-error",
    "smoke:mcp-schema": "node src/smoke-test.js mcp-schema",
    "smoke:api-docs": "node src/smoke-test.js api-docs",
    "smoke:behavior-docs": "node src/smoke-test.js behavior-docs",
    "smoke:runtime-status": "node src/smoke-test.js runtime-status",
    "smoke:inspect": "node src/smoke-test.js inspect",
    "smoke:small-copy-original": "node src/smoke-test.js small-copy-original"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "cn-font-split": "^7.4.2",
    "wawoff2": "^2.0.1"
  }
}
